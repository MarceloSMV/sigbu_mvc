@model List<sigbu_mvc.ViewModels.AreaSolicitudViewModel>
@{
    ViewData["Title"] = "Editar Áreas";
}

<div class="container mt-4">
    <div class="card shadow-sm border-warning mb-4">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-search"></i> Buscar Área</h5>
        </div>
        <div class="card-body">
            <label class="form-label fw-bold">Buscar por nombre:</label>
            <div class="input-group mb-2">
                <input type="text" id="search-term" class="form-control" placeholder="Escriba nombre..." autocomplete="off">
            </div>
            <div id="list-resultados" class="list-group position-absolute shadow w-100" style="z-index:1000; display:none;"></div>

            <div id="edit-form-temp" class="mt-3 p-3 border rounded bg-light" style="display:none;">
                <h6 class="text-muted border-bottom pb-2 mb-3">Datos del área (Edite antes de agregar)</h6>
                <input type="hidden" id="temp-id" />
                <div class="row g-2">
                    <div class="col-md-3"><label>Nombre</label><input type="text" id="temp-nombre" class="form-control form-control-sm" /></div>
                    <div class="col-md-3"><label>Responsable</label><input type="text" id="temp-responsable" class="form-control form-control-sm" /></div>
                    <div class="col-md-3"><label>Ubicación</label><input type="text" id="temp-ubicacion" class="form-control form-control-sm" /></div>
                    <div class="col-md-3"><label>Descripción</label><input type="text" id="temp-descripcion" class="form-control form-control-sm" /></div>
                    <div class="col-12 text-end mt-2">
                        <button type="button" id="btn-add-cola" class="btn btn-warning btn-sm fw-bold">Agregar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow border-warning">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Áreas a modificar</h5>
            <small id="contador-items" class="fw-bold">0 ítems</small>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post" id="form-editar-areas">
                <div class="card mb-4 bg-light border-secondary">
                    <div class="card-body">
                        <label class="form-label fw-bold text-dark">Sustento:</label>
                        <textarea class="form-control" id="sustento" name="sustento" rows="2" placeholder="Motivo de la edición..."></textarea>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Responsable</th>
                                <th>Ubicación</th>
                                <th>Descripción</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="tabla-cola"></tbody>
                    </table>
                </div>

                <div class="text-end mt-3">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="button" class="btn btn-warning fw-bold" id="btn-enviar" disabled>Enviar Solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const inputSearch = document.getElementById('search-term');
        const listResultados = document.getElementById('list-resultados');
        const editForm = document.getElementById('edit-form-temp');
        const tablaCola = document.getElementById('tabla-cola');
        const btnEnviar = document.getElementById('btn-enviar');
        let contador = 0;

        // BUSCADOR
        inputSearch.addEventListener('input', async function() {
            const term = this.value;
            if(term.length < 1) { listResultados.style.display='none'; return; }

            const res = await fetch(`@Url.Action("BuscarAreas")?term=${term}`);
            const data = await res.json();

            listResultados.innerHTML = '';
            if(data.length > 0){
                listResultados.style.display = 'block';
                data.forEach(item => {
                    const a = document.createElement('a');
                    a.className = 'list-group-item list-group-item-action';
                    a.innerText = item.nombre;
                    a.onclick = () => { cargarForm(item); listResultados.style.display='none'; inputSearch.value=''; };
                    listResultados.appendChild(a);
                });
            } else {
                listResultados.style.display = 'none';
            }
        });

        function cargarForm(item){
            editForm.style.display = 'block';
            document.getElementById('temp-id').value = item.id;
            document.getElementById('temp-nombre').value = item.nombre;
            document.getElementById('temp-responsable').value = item.responsable;
            document.getElementById('temp-ubicacion').value = item.ubicacion;
            document.getElementById('temp-descripcion').value = item.descripcion;
        }

        // AGREGAR
        document.getElementById('btn-add-cola').addEventListener('click', () => {
             const id = document.getElementById('temp-id').value;
             const existingIds = Array.from(tablaCola.querySelectorAll('input[name$=".area_id"]')).map(i => i.value);

             if (existingIds.includes(id)) {
                 mensajeSistema(2, "Esta área ya se encuentra en la lista de modificaciones.");
                 return;
             }

             // Capturar valores
             const nombre = document.getElementById('temp-nombre').value;
             const resp = document.getElementById('temp-responsable').value;
             const ubic = document.getElementById('temp-ubicacion').value;
             const desc = document.getElementById('temp-descripcion').value;

             const tr = document.createElement('tr');
             tr.innerHTML = `
                <input type="hidden" name="[${contador}].area_id" value="${id}" />
                <input type="hidden" name="[${contador}].nombre" value="${nombre}" />
                <input type="hidden" name="[${contador}].responsable" value="${resp}" />
                <input type="hidden" name="[${contador}].ubicacion" value="${ubic}" />
                <input type="hidden" name="[${contador}].descripcion" value="${desc}" />

                <td>${nombre}</td>
                <td>${resp}</td>
                <td>${ubic}</td>
                <td><small class="text-muted">${desc}</small></td> <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm btn-borrar">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
             `;
             tablaCola.appendChild(tr);
             editForm.style.display = 'none';

             reindexarFilasCola();
             actualizarContador();
        });

        // ELIMINAR FILA
        tablaCola.addEventListener('click', (e) => {
            if(e.target.closest('.btn-borrar')){
                e.target.closest('tr').remove();
                reindexarFilasCola();
                actualizarContador();
            }
        });

        // ENVIAR
        btnEnviar.addEventListener('click', function() {
            if (contador === 0) {
                mensajeSistema(2, "La lista de modificaciones está vacía.");
                return;
            }

            var txtSustento = document.getElementById("sustento").value.trim();
            if (txtSustento === "") {
                mensajeSistema(2, "El sustento es obligatorio. Indique el motivo de la edición.");
                return;
            }

            mensajeSistema(3, "¿Confirma el envío de esta solicitud de EDICIÓN de áreas?", function() {
                document.getElementById('form-editar-areas').submit();
            });
        });

        function reindexarFilasCola() {
             const filas = tablaCola.querySelectorAll('tr');
             filas.forEach((fila, index) => {
                 fila.querySelectorAll('input').forEach(input => {
                     if(input.name) input.name = input.name.replace(/\[\d+\]/, `[${index}]`);
                 });
             });
             contador = filas.length;
        }

        function actualizarContador() {
             const total = tablaCola.children.length;
             document.getElementById('contador-items').innerText = `${total} ítems`;
             btnEnviar.disabled = total === 0;
        }

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.input-group')) listResultados.style.display = 'none';
        });
    </script>
}