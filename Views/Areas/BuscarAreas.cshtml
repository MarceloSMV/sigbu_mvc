@model IEnumerable<sigbu_mvc.Models.Area>

@{
    ViewData["Title"] = "Buscar Áreas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-dark"><i class="bi bi-search"></i> Consultar Áreas</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-light bg-light">
        <div class="card-body p-3">
            <form asp-action="Buscar" method="get">
                <div class="row g-2 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Nombre</label>
                        <input type="text" name="nombre" class="form-control form-control-sm autocomplete-input"
                               value="@ViewData["filtroNombre"]" placeholder="Buscar nombre..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Responsable</label>
                        <input type="text" name="responsable" class="form-control form-control-sm autocomplete-input"
                               value="@ViewData["filtroResponsable"]" placeholder="Buscar responsable..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Ubicación</label>
                        <input type="text" name="ubicacion" class="form-control form-control-sm autocomplete-input"
                               value="@ViewData["filtroUbicacion"]" placeholder="Buscar ubicación..." />
                    </div>

                    <div class="col-md-3 text-end">
                        <a asp-action="Buscar" class="btn btn-outline-secondary btn-sm me-1" title="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                        <button type="submit" class="btn btn-primary btn-sm px-4">
                            <i class="bi bi-filter"></i> Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th class="text-center" style="width: 50px;">N°</th>
                            <th>Nombre</th>
                            <th>Responsable</th>
                            <th>Ubicación</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No se encontraron áreas con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int contador = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-secondary">@contador</td>
                                    <td class="fw-bold text-primary">@item.nombre</td>
                                    <td>@item.responsable</td>
                                    <td>@item.ubicacion</td>
                                    <td class="text-muted small">
                                        @(string.IsNullOrEmpty(item.descripcion) ? "N/A" : item.descripcion)
                                    </td>
                                </tr>
                                contador++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top-0 py-3">
            <small class="text-muted">Total de registros encontrados: <strong>@Model.Count()</strong></small>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>
        $(document).ready(function () {
            // Aplicamos autocompletado a los 3 inputs principales
            $("input[name='nombre'], input[name='responsable'], input[name='ubicacion']").autocomplete({
                source: function (request, response) {
                    // Detectamos cuál es el campo activo
                    var campoActual = this.element.attr("name");

                    $.ajax({
                        url: '@Url.Action("Autocompletar", "Areas")',
                        type: "GET",
                        dataType: "json",
                        data: {
                            term: request.term,
                            campo: campoActual // Enviamos 'nombre', 'responsable' o 'ubicacion'
                        },
                        success: function (data) {
                            response(data); // jQuery UI maneja arrays de strings automáticamente
                        }
                    });
                },
                minLength: 1
            });
        });
    </script>
}

