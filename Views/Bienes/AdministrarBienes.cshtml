@using System.Security.Claims
@{
    ViewData["Title"] = "Administrar Bienes";
}

<div class="container mt-4">

    <div class="card mb-5 border-0 shadow-sm">
        <div class="card-body d-flex align-items-center p-4" style="background-color: #e6fcf5; border-radius: 10px;">
            <div class="me-3 bg-white p-3 rounded-circle shadow-sm text-success">
                <i class="bi bi-box-seam fs-1"></i>
            </div>
            <div>
                <h2 class="mb-0 text-dark fw-bold">Administrar Bienes</h2>
                <p class="text-muted mb-0">Inventario y Gestión Patrimonial</p>
            </div>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 justify-content-center">
        <div class="col-md-5 col-lg-3">
            <a asp-action="Buscar" class="btn-opcion" style="background-color: #e7f5ff;">
                <i class="bi bi-search fs-1 mb-2 text-primary"></i>
                <span class="fs-5 fw-bold text-dark text-center">Consultar inventario</span>
            </a>
        </div>

        <div class="col-md-5 col-lg-3">
            <a asp-action="Agregar" class="btn-opcion" style="background-color: #d3f9d8;">
                <i class="bi bi-plus-square fs-1 mb-2 text-success"></i>
                <span class="fs-5 fw-bold text-dark text-center">Agregar bien</span>
            </a>
        </div>

        <div class="col-md-5 col-lg-3">
            <a asp-action="Editar" class="btn-opcion" style="background-color: #fff3bf;">
                <i class="bi bi-pencil-square fs-1 mb-2 text-warning"></i>
                <span class="fs-5 fw-bold text-dark text-center">Editar bien</span>
            </a>
        </div>

        <div class="col-md-5 col-lg-3">
            <a asp-action="Eliminar" class="btn-opcion" style="background-color: #ffe3e3;">
                <i class="bi bi-trash fs-1 mb-2 text-danger"></i>
                <span class="fs-5 fw-bold text-dark text-center">Eliminar bien</span>
            </a>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Login" asp-action="Login" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Panel Principal
        </a>
    </div>
</div>

<style>
    .btn-opcion {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 160px;
        border-radius: 15px;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.02);
    }

        .btn-opcion:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0,0,0,0.1);
            filter: brightness(0.97);
        }
</style>