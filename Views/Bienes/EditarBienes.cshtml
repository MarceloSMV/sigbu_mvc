@model List<sigbu_mvc.ViewModels.BienSolicitudViewModel>
@{
    ViewData["Title"] = "Editar Bienes";
}

<div class="container mt-4">
    <div class="card shadow-sm border-warning mb-4">
        <div class="card-header bg-warning text-dark"><h5 class="mb-0"><i class="bi bi-search"></i> Buscar Bien</h5></div>
        <div class="card-body">
            <label class="form-label fw-bold">Buscar por Código, Serie o Descripción:</label>
            <div class="input-group mb-2">
                <input type="text" id="search-term" class="form-control" placeholder="Escriba..." autocomplete="off">
            </div>
            <div id="list-resultados" class="list-group position-absolute shadow w-100" style="z-index:1000; display:none;"></div>

            <div id="edit-form-temp" class="mt-3 p-3 border rounded bg-light" style="display:none;">
                <h6 class="text-muted border-bottom pb-2 mb-3">Datos del bien (Edite antes de agregar)</h6>
                <input type="hidden" id="temp-id" />

                <div class="row g-2">
                    <div class="col-md-2">
                        <label>Código</label>
                        <input type="text" id="temp-codigo" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label>Serie</label>
                        <input type="text" id="temp-serie" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label>Descripción</label>
                        <input type="text" id="temp-descripcion" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label>Color</label>
                        <input type="text" id="temp-color" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label>Ubicación</label>
                        <input type="text" id="temp-ubicacion" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label>Área</label>
                        <select id="temp-area" class="form-select form-select-sm" asp-items="ViewBag.Areas"></select>
                    </div>
                    <div class="col-md-6">
                        <label>Estado</label>
                        <select id="temp-estado" class="form-select form-select-sm" asp-items="ViewBag.Estados"></select>
                    </div>

                    <div class="col-12 text-end mt-2">
                        <button type="button" id="btn-add-cola" class="btn btn-warning btn-sm fw-bold">Agregar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow border-warning">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Bienes a modificar</h5>
            <small id="contador-items" class="fw-bold">0 ítems</small>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post" id="form-editar-bienes">
                <div class="card mb-4 bg-light border-secondary">
                    <div class="card-body">
                        <label class="form-label fw-bold text-dark">Sustento:</label>
                        <textarea class="form-control" id="sustento" name="sustento" rows="2" placeholder="Motivo de la edición..."></textarea>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Serie</th>
                                <th>Descripción</th>
                                <th>Color</th>
                                <th>Ubicación</th>
                                <th>Área</th>
                                <th>Estado</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="tabla-cola"></tbody>
                    </table>
                </div>
                <div class="text-end mt-3">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                    <button type="button" class="btn btn-warning fw-bold" id="btn-enviar" disabled>Enviar Solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const inputSearch = document.getElementById('search-term');
        const listResultados = document.getElementById('list-resultados');
        const editForm = document.getElementById('edit-form-temp');
        const tablaCola = document.getElementById('tabla-cola');
        const btnEnviar = document.getElementById('btn-enviar');
        let contador = 0;

        inputSearch.addEventListener('input', async function() {
            const term = this.value;
            if(term.length < 3) { listResultados.style.display='none'; return; }
            const res = await fetch(`@Url.Action("BuscarBienes")?term=${term}`);
            const data = await res.json();

            listResultados.innerHTML = '';
            if(data.length > 0){
                listResultados.style.display = 'block';
                data.forEach(item => {
                    const a = document.createElement('a');
                    a.className = 'list-group-item list-group-item-action';

                    const tc = item.codigo ? `[${item.codigo}]` : '[S/C]';
                    const ts = item.serie ? `[${item.serie}]` : '[S/S]';
                    a.innerText = `${tc} ${ts} ${item.descripcion}`;

                    a.onclick = () => { cargarForm(item); listResultados.style.display='none'; inputSearch.value=''; };
                    listResultados.appendChild(a);
                });
            } else { listResultados.style.display = 'none'; }
        });

        function cargarForm(item){
            editForm.style.display = 'block';
            document.getElementById('temp-id').value = item.id;
            document.getElementById('temp-codigo').value = item.codigo;
            document.getElementById('temp-serie').value = item.serie;
            document.getElementById('temp-descripcion').value = item.descripcion;
            document.getElementById('temp-color').value = item.color;
            document.getElementById('temp-ubicacion').value = item.ubicacion;
            document.getElementById('temp-area').value = item.area_id;
            document.getElementById('temp-estado').value = item.estado;
        }

        document.getElementById('btn-add-cola').addEventListener('click', async function() {
             const id = document.getElementById('temp-id').value;
             const existingIds = Array.from(tablaCola.querySelectorAll('input[name$=".bien_id"]')).map(i => i.value);
             if (existingIds.includes(id)) { mensajeSistema(2, "Este bien ya está en la lista."); return; }

             const data = {
                 codigo: document.getElementById('temp-codigo').value.trim(),
                 serie: document.getElementById('temp-serie').value.trim(),
                 descripcion: document.getElementById('temp-descripcion').value.trim(),
                 color: document.getElementById('temp-color').value.trim(),
                 ubicacion: document.getElementById('temp-ubicacion').value.trim(),
                 areaId: document.getElementById('temp-area').value,
                 areaTxt: document.getElementById('temp-area').options[document.getElementById('temp-area').selectedIndex].text,
                 estado: document.getElementById('temp-estado').value
             };

             if (!data.descripcion) { mensajeSistema(2, "Descripción obligatoria."); return; }
             if (!data.areaId) { mensajeSistema(2, "Seleccione área."); return; }
             if (!data.codigo && !data.serie) { mensajeSistema(2, "Ingrese Código o Serie."); return; }

             // Validar DB excluyendo el propio ID
             if (data.codigo || data.serie) {
                try {
                    const params = new URLSearchParams();
                    if(data.codigo) params.append('codigo', data.codigo);
                    if(data.serie) params.append('serie', data.serie);
                    params.append('idExcluir', id);

                    const res = await fetch(`@Url.Action("VerificarExistencia")?${params.toString()}`);
                    const existe = await res.json();
                    if (existe.codigo) { mensajeSistema(2, `El código '${data.codigo}' ya pertenece a otro bien.`); return; }
                    if (existe.serie) { mensajeSistema(2, `La serie '${data.serie}' ya pertenece a otro bien.`); return; }
                } catch (e) { mensajeSistema(2, "Error de validación."); return; }
             }

             const tr = document.createElement('tr');
             tr.innerHTML = `
                <input type="hidden" name="[${contador}].bien_id" value="${id}" />
                <input type="hidden" name="[${contador}].codigo" value="${data.codigo}" />
                <input type="hidden" name="[${contador}].serie" value="${data.serie}" />
                <input type="hidden" name="[${contador}].descripcion" value="${data.descripcion}" />
                <input type="hidden" name="[${contador}].color" value="${data.color}" />
                <input type="hidden" name="[${contador}].ubicacion" value="${data.ubicacion}" />
                <input type="hidden" name="[${contador}].area_id" value="${data.areaId}" />
                <input type="hidden" name="[${contador}].estado" value="${data.estado}" />

                <td>${data.codigo || '-'}</td>
                <td>${data.serie || '-'}</td>
                <td>${data.descripcion}</td>
                <td>${data.color || '-'}</td>
                <td>${data.ubicacion || '-'}</td>
                <td>${data.areaTxt}</td>
                <td>${data.estado}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm btn-borrar"><i class="bi bi-trash"></i></button>
                </td>
             `;
             tablaCola.appendChild(tr);
             editForm.style.display = 'none';
             reindexarFilasCola();
             actualizarContador();
        });

        tablaCola.addEventListener('click', (e) => {
            if(e.target.closest('.btn-borrar')){ e.target.closest('tr').remove(); reindexarFilasCola(); actualizarContador(); }
        });

        btnEnviar.addEventListener('click', function() {
            if (contador === 0) { mensajeSistema(2, "La lista está vacía."); return; }
            if (document.getElementById("sustento").value.trim() === "") { mensajeSistema(2, "El sustento es obligatorio."); return; }
            mensajeSistema(3, "¿Confirma la solicitud de EDICIÓN?", () => document.getElementById('form-editar-bienes').submit());
        });

        function reindexarFilasCola() {
             const filas = tablaCola.querySelectorAll('tr');
             filas.forEach((fila, index) => {
                 fila.querySelectorAll('input').forEach(input => {
                     if(input.name) input.name = input.name.replace(/\[\d+\]/, `[${index}]`);
                 });
             });
             contador = filas.length;
        }
        function actualizarContador() {
             const total = tablaCola.children.length;
             document.getElementById('contador-items').innerText = `${total} ítems`;
             btnEnviar.disabled = total === 0;
        }
        document.addEventListener('click', (e) => { if (!e.target.closest('.input-group')) listResultados.style.display = 'none'; });
    </script>
}