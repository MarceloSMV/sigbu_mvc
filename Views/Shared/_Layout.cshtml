@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGBU</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>

    <header style="background-color: #e6fcf5; border-bottom: 2px solid #c3fae8; padding: 10px 20px;">
        <div class="d-flex justify-content-between align-items-center">

            <div class="d-flex align-items-center">
                @{
                    // Determinamos el controlador y acción destino
                    string controllerDestino = "Login";
                    string actionDestino = "Index";

                    if (User.IsInRole("Jefe"))
                    {
                        actionDestino = "DashboardJefe";
                    }
                    else if (User.IsInRole("Trabajador"))
                    {
                        actionDestino = "DashboardTrabajador";
                    }
                }

                <a asp-controller="@controllerDestino"
                   asp-action="@actionDestino"
                   class="d-flex align-items-center text-decoration-none">
                    <img src="~/img/logosigbu.png" alt="Logo SIGBU" style="height: 100px; margin-right: 15px;" />
                </a>
            </div>
            @if (User.Identity!.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="btn d-flex align-items-center gap-3 border-0 bg-transparent" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="text-end lh-1">
                            <div class="fw-bold text-dark" style="font-size: 1.1rem;">
                                Hola, @User.FindFirst(ClaimTypes.Name)?.Value
                            </div>
                            <small class="text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">
                                @User.FindFirst(ClaimTypes.Role)?.Value
                            </small>
                        </div>
                        <i class="bi bi-chevron-down text-dark"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 200px;">
                        <li>
                            <a class="dropdown-item py-2" asp-controller="CambiarContrasena" asp-action="CambiarContrasena">
                                <i class="bi bi-key me-2 text-primary"></i> Cambiar Contraseña
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <a class="dropdown-item py-2 text-danger" asp-controller="CerrarSesion" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_MensajeSistema" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["Mensaje"] != null)
    {
        // Detectamos el tipo (1=Verde, 2=Rojo). Si es nulo, por defecto es 1.
        var tipo = TempData["TipoMensaje"] != null ? Convert.ToInt32(TempData["TipoMensaje"]) : 1;

        <script>
            document.addEventListener("DOMContentLoaded", function() {
                if (typeof mensajeSistema === 'function') {
                    // Llama a TU modal _MensajeSistema.cshtml
                    mensajeSistema(@tipo, '@Html.Raw(TempData["Mensaje"])');
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>