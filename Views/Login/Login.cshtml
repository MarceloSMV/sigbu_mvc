@model sigbu_mvc.Models.Usuario
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Iniciar Sesión - SIGBU</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        /* ... tus estilos existentes ... */
        body {
            background-color: #f8f9fa;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            background-color: #e6fcf5;
        }

        .login-logo {
            max-height: 100px;
            width: auto;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="text-center">
            <img src="~/img/logosigbu.png" alt="Logo SIGBU" class="login-logo" />
        </div>

        <p class="text-center text-muted mb-4">Ingrese sus credenciales</p>

        <form asp-controller="Login" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Usuario</label>
                <input type="text" name="usuario_login" class="form-control" placeholder="Ej: admin" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Contraseña</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>
            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg">Ingresar</button>
            </div>
            <div class="text-center mt-3">
                <a asp-controller="RecuperarContrasena" asp-action="RestablecerContrasena" class="text-decoration-none small text-muted">¿Olvidaste tu contraseña?</a>
            </div>
        </form>
    </div>

    <partial name="_MensajeSistema" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Mostrar mensajes del servidor (TempData/ViewData)
            @if (ViewData["Mensaje"] != null)
            {
                    <text>mensajeSistema(2, "@Html.Raw(ViewData["Mensaje"])");</text>
            }
            @if (TempData["Mensaje"] != null)
            {
                    <text>
                        var msj = "@Html.Raw(TempData["Mensaje"])";
                        var tipo = msj.includes("incorrectos") || msj.includes("denegada") ? 2 : 1;
                        mensajeSistema(tipo, msj);
                    </text>
            }

            // --- NUEVA VALIDACIÓN DE LONGITUD ---
            const formLogin = document.querySelector('form');
            const inputUser = document.querySelector('input[name="usuario_login"]');
            const inputPass = document.querySelector('input[name="password"]');

            formLogin.addEventListener('submit', function(e) {
                const userVal = inputUser.value.trim();
                const passVal = inputPass.value.trim();

                // Regla: Usuario >= 4 caracteres
                if (userVal.length < 4) {
                    e.preventDefault(); // Detener envío
                    mensajeSistema(2, "El nombre de usuario debe tener al menos 4 caracteres.");
                    return;
                }

                // Regla: Contraseña >= 8 caracteres
                if (passVal.length < 8) {
                    e.preventDefault(); // Detener envío
                    mensajeSistema(2, "La contraseña debe tener al menos 8 caracteres.");
                    return;
                }
            });
        });
    </script>
</body>
</html>