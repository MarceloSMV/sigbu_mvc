@model sigbu_mvc.ViewModels.TransferenciaSolicitudViewModel
@{
    ViewData["Title"] = "Nueva Transferencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body d-flex align-items-center p-4" style="background-color: #f3f0ff; border-radius: 10px;">
            <div class="me-3 bg-white p-3 rounded-circle shadow-sm" style="color: #6f42c1;">
                <i class="bi bi-arrow-left-right fs-1"></i>
            </div>
            <div class="flex-grow-1">
                <h2 class="mb-0 text-dark fw-bold">Nueva Transferencia</h2>
                <p class="text-muted mb-0">Movimiento de bienes entre áreas</p>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm">
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
        </div>
    }

    <form asp-action="NuevaTransferencia" method="post" id="form-transferencia">

        <div class="card shadow-sm mb-4 border-0">
            <div class="card-header text-white" style="background-color: #7950f2;">
                <h5 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>Datos de Origen y Destino</h5>
            </div>
            <div class="card-body bg-light bg-opacity-25">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-primary">Área de Origen</label>
                        <select asp-for="AreaOrigenId" class="form-select shadow-sm" id="ddlAreaOrigen">
                            <option value="">-- Seleccione Origen --</option>
                            @if (Model.ListaAreas != null)
                            {
                                foreach (var item in Model.ListaAreas)
                                {
                                    <option value="@item.id">@item.nombre</option>
                                }
                            }
                        </select>
                        <div class="form-text">El área desde donde saldrán los bienes.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-primary">Área Destino</label>
                        <select asp-for="AreaDestinoId" class="form-select shadow-sm" id="ddlAreaDestino">
                            <option value="">-- Seleccione Destino --</option>
                            @if (Model.ListaAreas != null)
                            {
                                foreach (var item in Model.ListaAreas)
                                {
                                    <option value="@item.id">@item.nombre</option>
                                }
                            }
                        </select>
                        <div class="form-text">El área que recibirá los bienes.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Sustento / Motivo</label>
                    <textarea asp-for="Sustento" id="txtSustento" class="form-control shadow-sm" rows="3" placeholder="Describa el motivo de la transferencia..."></textarea>
                </div>

                <div class="text-end">
                    <button type="button" class="btn text-white px-4" id="btnSiguiente" style="background-color: #7950f2;">
                        Siguiente <i class="bi bi-chevron-down ms-1"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="seccionBienes" class="card shadow-sm d-none border-0">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0 text-dark"><i class="bi bi-check2-square me-2"></i>Selección de Bienes (Disponibles en Origen)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle border">
                        <thead class="text-white" style="background-color: #5f3dc4;">
                            <tr>
                                <th class="text-center" style="width:50px;"><i class="bi bi-check-lg"></i></th>
                                <th>Código</th>
                                <th>Serie</th>
                                <th>Descripción</th>
                                <th>Color</th>
                            </tr>
                        </thead>
                        <tbody id="tablaBienesBody"></tbody>
                    </table>
                </div>

                <div id="loadingSpinner" class="text-center py-4 d-none">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Buscando bienes...</p>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="button" class="btn btn-success btn-lg shadow-sm" id="btnConfirmarTransf">
                        <i class="bi bi-send-check me-2"></i> Confirmar Transferencia
                    </button>
                </div>
            </div>
        </div>

    </form>


    <div class="text-center mt-5">
        <a asp-controller="Login" asp-action="Login" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Panel Principal
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // VALIDACIÓN Y ENVÍO
            $("#btnConfirmarTransf").click(function () {
                // 1. Validar Bienes
                if ($(".check-bien:checked").length === 0) {
                    mensajeSistema(2, "Debe seleccionar al menos un bien de la lista para transferir.");
                    return;
                }
                // 2. Validar Sustento
                var sustento = $("#txtSustento").val().trim();
                if (sustento === "") {
                    mensajeSistema(2, "El campo de sustento es obligatorio. Por favor detalle el motivo.");
                    return;
                }
                // 3. Confirmar
                mensajeSistema(3, "¿Está seguro de enviar esta solicitud de transferencia?", function() {
                    $("#form-transferencia").submit();
                });
            });

            // CARGA DE BIENES (Tu lógica original)
            $("#btnSiguiente").click(function () {
                var origenId = $("#ddlAreaOrigen").val();
                var destinoId = $("#ddlAreaDestino").val();

                if (!origenId || !destinoId) {
                    mensajeSistema(2, "Por favor, seleccione ambas áreas (Origen y Destino).");
                    return;
                }
                if (origenId == destinoId) {
                    mensajeSistema(2, "El área de origen y destino no pueden ser iguales.");
                    return;
                }
                cargarBienes(origenId);
            });

            $("#ddlAreaOrigen").change(function(){
                $("#seccionBienes").addClass("d-none");
                $("#tablaBienesBody").empty();
            });

            function cargarBienes(areaId) {
                $("#seccionBienes").removeClass("d-none");
                $("#tablaBienesBody").empty();
                $("#loadingSpinner").removeClass("d-none");

                $.ajax({
                    url: '@Url.Action("GetBienesPorArea", "Transferencias")',
                    type: 'GET',
                    data: { areaId: areaId },
                    success: function (data) {
                        var html = "";
                        if (!data || data.length === 0) {
                            html = '<tr><td colspan="5" class="text-center text-muted p-4">No se encontraron bienes en el área seleccionada.</td></tr>';
                        } else {
                            $.each(data, function (i, item) {
                                html += '<tr class="fila-bien" style="transition: all 0.2s;">';
                                html += '  <td class="text-center align-middle">';
                                html += '    <div class="form-check d-flex justify-content-center">';
                                html += '      <input type="checkbox" name="BienesSeleccionados" value="' + item.id + '" class="form-check-input check-bien" style="cursor:pointer; transform: scale(1.2);" />';
                                html += '    </div>';
                                html += '  </td>';
                                html += '  <td class="fw-bold text-primary">' + (item.codigo || '-') + '</td>';
                                html += '  <td>' + (item.serie || '-') + '</td>';
                                html += '  <td>' + (item.descripcion || 'Sin descripción') + '</td>';
                                html += '  <td>' + (item.color || '-') + '</td>';
                                html += '</tr>';
                            });
                        }
                        $("#tablaBienesBody").html(html);
                    },
                    error: function (xhr, status, error) {
                        mensajeSistema(2, "Ocurrió un error de conexión al cargar los bienes.");
                    },
                    complete: function () {
                        $("#loadingSpinner").addClass("d-none");
                    }
                });
            }

            $(document).on("change", ".check-bien", function () {
                var row = $(this).closest("tr");
                if ($(this).is(":checked")) {
                    row.css("background-color", "#f3f0ff");
                    row.css("opacity", "0.7");
                } else {
                    row.css("background-color", "");
                    row.css("opacity", "1");
                }
            });
        });
    </script>
}